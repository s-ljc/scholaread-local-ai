+        chat_template_kwargs: { enable_thinking: false },
+        messages: [
+            { role: 'system', content: sys },
+            { role: 'user', content: text }
+        ]
+    });
+    let p;
+    if (aiBridgeOn()) {
+        p = aiBridgeFetch(aiNormalizeBaseUrl(cfg.baseUrl) + '/chat/completions', body, cfg.apiKey);
+    } else {
+        p = fetch(aiFetchUrl(cfg), {
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': 'Bearer ' + cfg.apiKey
+            },
+            body: body
+        }).then(function (r) {
+            if (!r.ok) throw new Error('HTTP ' + r.status + ' from local AI');
+            return r.text();
+        });
+    }
+    return p.then(function (txt) {
+        let j = null;
+        try { j = JSON.parse(txt); } catch (e) {}
+        const c = j && j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content;
+        if (!c) throw new Error('empty completion from local AI');
+        return String(c).trim();
+    });
+}
+
+function localAiChatOne(text, targetLanguage) {
+    const cfg = aiCfgGet();
+    const key = aiCacheKey(cfg.model, targetLanguage, text);
+    return aiCacheGet(key).then(function (hit) {
+        if (hit) return hit;
+        return localAiChatOneRaw(text, targetLanguage).then(function (out) {
+            aiCacheSet(key, out);
+            return out;
+        });
+    });
+}
+
+function localAiTranslate(texts, targetLanguage) {
+    return Promise.all(texts.map(function (t) { return localAiChatOne(t, targetLanguage); }));
+}
