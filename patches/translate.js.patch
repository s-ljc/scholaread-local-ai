+function aiDb() {
+    if (aiDbP) return aiDbP;
+    aiDbP = new Promise(function (res) {
+        try {
+            const rq = indexedDB.open('scholaread_ai_cache', 1);
+            rq.onupgradeneeded = function () { rq.result.createObjectStore('t'); };
+            rq.onsuccess = function () { res(rq.result); };
+            rq.onerror = function () { res(null); };
+            setTimeout(function () { res(null); }, 3000);
+        } catch (e) { res(null); }
+    });
+    return aiDbP;
+}
+function aiCacheKey(model, lang, text) {
+    const s = model + '|' + lang + '|' + text;
+    let h = 0x811c9dc5;
+    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
+    return (h >>> 0).toString(36) + '_' + s.length;
+}
+function aiCacheGet(key) {
+    if (aiMemCache.has(key)) return Promise.resolve(aiMemCache.get(key));
+    return aiDb().then(function (db) {
+        if (!db) return null;
+        return new Promise(function (res) {
+            try {
+                const rq = db.transaction('t', 'readonly').objectStore('t').get(key);
+                rq.onsuccess = function () { const v = rq.result || null; if (v) aiMemCache.set(key, v); res(v); };
